{
  "name": "oshawott",
  "version": "0.1.2",
  "private": true,
  "description": "A Pi Durable agent as a Chromium and Firefox browser extension",
  "license": "MIT",
  "author": "ming-kang",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chromium": "node scripts/build.mjs chromium",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:dev": "node scripts/build.mjs --dev",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "sign:firefox": "npm run package && node --env-file-if-exists=.env scripts/sign-firefox.mjs",
    "check": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "smoke:chromium": "node scripts/build.mjs chromium --dev && node scripts/smoke-chromium.mjs",
    "smoke:firefox": "node scripts/build.mjs firefox --dev && node scripts/smoke-firefox.mjs",
    "screenshots": "node scripts/build.mjs chromium --dev && node scripts/screenshots.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2"
  }
}
